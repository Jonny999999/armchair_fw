	(text "MA732\n- hard to get\n- simple SPI interface (MISO + SCK + CS only)\n- read only automatically starts at CS edge\n- abs angle only\nhttps://www.farnell.com/datasheets/3437340.pdf"
		(exclude_from_sim no)
		(at 27.94 187.452 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "0086f52e-939b-49ec-888b-9d4b3b1925ff")
	)
	(text "As5600\n- [already available]\n- i2c \n- read angle only\n- NOT addressable -> i2c multiplexer necessary\nhttps://www.mouser.de/datasheet/2/588/asset_pdf_25493149-3419514.pdf"
		(exclude_from_sim no)
		(at 26.416 143.51 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "068aae1b-2168-4125-ab8f-e3c58365e1c6")
	)
	(text "New idea: use MCU next to sensor for communication via MODBUS instead of SSC\nSensor --SSC--->  ATiny4313  --UART-->  MAX485     ---MODBUS--->      MAX3485 ----UART---> ESP32"
		(exclude_from_sim no)
		(at 25.908 22.606 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "068fdfe3-d718-4a44-a1f6-08046b097206")
	)
	(text "I2c extender  P82B715\nhttps://www.horter.de/doku/P82B715.pdf"
