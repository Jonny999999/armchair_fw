	)
	(text "AS5048B\n- ABS angle only\n- AS5048A - SPI (daisy chain possible (4 pin spi for multiple)\n- AS5048B - I2C (custom address via pin)\nhttps://www.mouser.de/datasheet/2/588/AS5048_DS000298_4_00-2324531.pdf"
		(exclude_from_sim no)
